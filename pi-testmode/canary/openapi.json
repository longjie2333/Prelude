{
  "openapi": "3.0.3",
  "info": { "title": "Canary inventory/order service", "version": "1.0.0" },
  "servers": [{ "url": "http://localhost:4100" }],
  "paths": {
    "/health": { "get": { "responses": { "200": { "description": "Service is up" } } } },
    "/reset": {
      "post": {
        "summary": "Reset all state to the seed data",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "stock": { "type": "object", "additionalProperties": { "type": "integer" }, "description": "Override stock per product id" } }
              }
            }
          }
        },
        "responses": { "200": { "description": "Reset" } }
      }
    },
    "/products": {
      "get": {
        "summary": "List products, paginated",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
          { "name": "size", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 3 } }
        ],
        "responses": {
          "200": {
            "description": "A page of products. Every product appears on exactly one page.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProductPage" } } }
          }
        }
      },
      "post": {
        "summary": "Create a product",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NewProduct" } } } },
        "responses": {
          "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Product" } } } },
          "400": { "description": "Invalid input" }
        }
      }
    },
    "/products/{id}": {
      "get": {
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "The product", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Product" } } } },
          "404": { "description": "Not found" }
        }
      }
    },
    "/coupons/{code}": {
      "get": {
        "parameters": [{ "name": "code", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Coupon with its quota and remaining claims" }, "404": { "description": "Not found" } }
      }
    },
    "/coupons/{code}/claim": {
      "post": {
        "summary": "Claim one use of a coupon. remaining never goes below zero.",
        "parameters": [{ "name": "code", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "201": { "description": "Claimed" }, "409": { "description": "Quota exhausted" } }
      }
    },
    "/orders": {
      "get": { "responses": { "200": { "description": "All orders" } } },
      "post": {
        "summary": "Place an order. Stock is decremented by qty; stock never goes below zero.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["productId", "qty"],
                "properties": { "productId": { "type": "string" }, "qty": { "type": "integer", "minimum": 1 } }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Order placed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } } },
          "409": { "description": "Insufficient stock" }
        }
      }
    },
    "/orders/{id}/cancel": {
      "post": {
        "summary": "Cancel an order and return its quantity to stock",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Cancelled" }, "404": { "description": "Not found" }, "409": { "description": "Already cancelled" } }
      }
    }
  },
  "components": {
    "schemas": {
      "Product": {
        "type": "object",
        "required": ["id", "name", "price", "stock"],
        "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "price": { "type": "number" }, "stock": { "type": "integer", "minimum": 0 } }
      },
      "NewProduct": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string", "description": "Any UTF-8 text" }, "price": { "type": "number" }, "stock": { "type": "integer" } }
      },
      "ProductPage": {
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Product" } },
          "page": { "type": "integer" },
          "size": { "type": "integer" },
          "total": { "type": "integer" },
          "pages": { "type": "integer" }
        }
      },
      "Order": {
        "type": "object",
        "properties": { "id": { "type": "string" }, "productId": { "type": "string" }, "qty": { "type": "integer" }, "status": { "type": "string", "enum": ["placed", "cancelled"] } }
      }
    }
  }
}
